# GitHub Personal Access Token with repo scope permissions
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Target GitHub repository (format: owner/repository_name)
GITHUB_REPO=username/daily-newsletters

# Schedule interval in hours (default: 4)
FETCH_INTERVAL_HOURS=4

# Target directory in repository for Jekyll posts (default: _posts)
POSTS_DIR=_posts
